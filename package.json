{
  "name": "lexyns-clean",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site Lexyns Clean Sibiu, cu editor pentru client.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:cloudflare": "npm run build && wrangler pages dev dist --port 5174",
    "db:init": "wrangler d1 execute EDITOR_DB --local --file=cloudflare/schema.sql",
    "admin:password": "node scripts/password.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.147.0"
  }
}
